{
  // Metro-bundled Expo app. Extends BOTH bases — later entries win per key: the
  // Expo base supplies the RN semantics (jsx react-jsx, customConditions
  // ["react-native"], allowJs, resolveJsonModule, esModuleInterop), then the
  // repo-wide base re-tightens strictness on top. The bundler-vs-NodeNext keys
  // the repo base warns about are restated below — the only sanctioned split
  // (see ../../tsconfig.base.json).
  "extends": ["expo/tsconfig.base", "../../tsconfig.base.json"],
  "compilerOptions": {
    // NOT composite, and noEmit. An app is a BUILD LEAF: nothing in the workspace
    // imports it, so it never needs to emit a declaration — and it MUST NOT, because
    // its own type surface (the tRPC client carries @trpc/client's module-private
    // `untypedClientSymbol`) cannot be named in a .d.ts. Composite would force that
    // emit and red with TS2883/TS2322. Instead the app is typechecked as a `tsc -b`
    // BUILD ROOT (its `references` still build the composite packages it depends on),
    // which needs neither composite nor emit on the app itself. Metro owns JS output.
    // SOURCE: design/W1-STACK-SPEC.md §3 (leaf apps are non-composite, noEmit)
    "noEmit": true,
    // The repo base turns all three ON for the composite package graph. They must be turned
    // OFF here explicitly: `declaration: true` makes tsc run the declaration-NAMEABILITY check
    // even under noEmit, which is what reds with TS2883 on the tRPC client's private symbol.
    // A leaf that emits nothing needs none of them.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    // The repo base narrows lib to ES2023; RN + Expo typings lean on the Expo
    // base's DOM+ESNext surface (fetch/URL/FormData globals) — restore it.
    "lib": ["DOM", "ESNext"],
    // jest: the component/screen suites use jest-expo globals. node: the
    // routes-closure test walks app/ with node:fs (jest runs on Node; the
    // types coexist with the DOM lib by design).
    "types": ["jest", "node"],
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  // package.json is listed because app.config.ts imports it (resolveJsonModule)
  // and a composite project must name every input file.
  "include": ["app", "src", "__tests__", "app.config.ts", "jest.setup.ts", "package.json"],
  // LOCKSTEP with package.json.tmpl: every @app/* specifier this app resolves
  // needs its project named here. A missing reference does not error — it widens
  // the import to `any`, which is exactly the silent degradation that
  // src/lib/trpc/client.ts's IsAny<AppRouter> assertion exists to red on.
  // @app/api is listed despite being a devDependency consumed `import type`
  // only: the reference is what makes the type real, and the type erasure is
  // what keeps the value out of the bundle. The two are independent.
  "references": [
    { "path": "../../packages/api" },
    { "path": "../../packages/contracts" },
    { "path": "../../packages/design-tokens" },
    { "path": "../../packages/platform/errors" },
    { "path": "../../packages/platform/supabase" }
  ]
}
