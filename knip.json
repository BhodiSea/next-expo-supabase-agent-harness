{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.mjs",
    // Invoked from scripts/ci/*.sh, which knip cannot follow — a shell `node <path>` is
    // not an import. Without this an CI-only helper reads as dead code, and the prescribed
    // fix for dead code is deletion.
    "scripts/ci/*.mjs",
    "tests/**/*.test.mjs",
    "template/base/tools/*.mjs",
    "template/base/stryker.config.mjs",
    "template/base/tools/lib/perf-subject-cli.mjs",
    "template/base/tools/mcp/*.mjs",
    "template/base/.claude/hooks/*.mjs",
    "template/base/.claude/statusline.mjs",
    "template/base/.claude/skills/*/scripts/*.mjs",
    "template/base/tests/rls/run-rls.mjs"
  ],
  "project": [
    "installer/**/*.mjs",
    "scripts/**/*.mjs",
    "tests/**/*.mjs",
    "template/base/tools/**/*.mjs",
    "template/base/.claude/hooks/**/*.mjs",
    "template/base/tests/**/*.mjs"
  ],
  "ignore": [
    // template trees are CONSUMER source, not repo source. stack/** and the
    // base .ts files resolve only inside a scaffold (workspace deps, jest-expo).
    // modules/** stays ignored DELIBERATELY now that W7 ships files: module
    // tools import ./lib/gate.mjs — template/base/tools/lib/gate.mjs, which
    // exists at that relative path only after `enable` installs them next to
    // the base tools — and module .ts/.tsx/.txt files need consumer deps.
    // Scanned here they would all red as unresolved imports (same call as SRC).
    "template/stack/**",
    "template/modules/**",
    "template/base/**/*.ts"
  ],
  // Specifiers that resolve only inside an installed scaffold, never in this repo:
  // the inventory generators lazily import the CONSUMER's router/catalogs, and the
  // rls-verify MCP probe takes postgres.js as a scaffold devDependency. `supabase`
  // is likewise the consumer's catalog-pinned CLI, spawned by the RLS runner.
  "ignoreDependencies": [
    "@modelcontextprotocol/sdk",
    "@stryker-mutator/api",
    "@app/api",
    "@app/events",
    "@app/notes",
    "postgres"
  ],
  "ignoreBinaries": ["biome", "vitest", "stryker", "supabase"]
}
