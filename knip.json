{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.mjs",
    "tests/**/*.test.mjs",
    "template/base/tools/*.mjs",
    "template/base/stryker.config.mjs",
    "template/base/tools/lib/perf-subject-cli.mjs",
    "template/base/tools/mcp/*.mjs",
    "template/base/.claude/hooks/*.mjs",
    "template/base/.claude/statusline.mjs",
    "template/base/.claude/skills/*/scripts/*.mjs",
    "template/base/tests/rls/run-rls.mjs",
    "template/base/tests/migrations/migration-apply.mjs"
  ],
  "project": [
    "installer/**/*.mjs",
    "scripts/**/*.mjs",
    "tests/**/*.mjs",
    "template/base/tools/**/*.mjs",
    "template/base/.claude/hooks/**/*.mjs",
    "template/base/tests/**/*.mjs"
  ],
  "ignore": [
    // template trees are CONSUMER source, not repo source. stack/** and the
    // base .ts files resolve only inside a scaffold (workspace deps, jest-expo).
    // modules/** stays ignored DELIBERATELY now that W7 ships files: module
    // tools import ./lib/gate.mjs — template/base/tools/lib/gate.mjs, which
    // exists at that relative path only after `enable` installs them next to
    // the base tools — and module .ts/.tsx/.txt files need consumer deps.
    // Scanned here they would all red as unresolved imports (same call as SRC).
    "template/stack/**",
    "template/modules/**",
    "template/base/**/*.ts"
  ],
  "ignoreDependencies": ["@modelcontextprotocol/sdk", "@stryker-mutator/api"],
  "ignoreBinaries": ["biome", "vitest", "stryker"]
}
