{
  "name": "next-expo-supabase-agent-harness",
  "version": "2.0.4",
  "description": "A CLI that scaffolds a Next.js and Expo (React Native) monorepo on Supabase, with Claude Code hooks and CI gates that block an agent turn or a merge until validation passes.",
  "license": "Apache-2.0",
  "author": "Cogvera Labs",
  "homepage": "https://bhodisea.github.io/next-expo-supabase-agent-harness/",
  "bugs": {
    "url": "https://github.com/BhodiSea/next-expo-supabase-agent-harness/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BhodiSea/next-expo-supabase-agent-harness.git"
  },
  "bin": {
    "next-expo-supabase-agent-harness": "installer/cli.mjs"
  },
  "type": "module",
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "installer",
    "template",
    "CHANGELOG.md",
    "REUSE.toml",
    "LICENSE",
    "LICENSES"
  ],
  "scripts": {
    "bootstrap": "node installer/cli.mjs init --consume",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "keywords": [
    "claude-code",
    "claude-code-hooks",
    "claude-code-plugin",
    "coding-agent",
    "agent-harness",
    "nextjs",
    "expo",
    "expo-router",
    "react-native",
    "supabase",
    "postgres",
    "rls",
    "row-level-security",
    "pgtap",
    "trpc",
    "monorepo",
    "pnpm",
    "typescript",
    "cli",
    "scaffold",
    "starter",
    "quality-gates",
    "supply-chain-security",
    "provenance",
    "vercel",
    "eas"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.5",
    "eslint": "9.39.5",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "knip": "6.43.0",
    "typescript": "6.0.3"
  }
}
