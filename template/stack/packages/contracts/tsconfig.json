{
  // @app/contracts — pure-Zod wire contracts, consumed by BOTH sides of the wire
  // (apps/server and apps/mobile). Plain ESM, no bundler, zod-only: nothing in
  // this package may import drizzle — the architecture gate enforces it.
  // Extends the repo-wide max-strict base; NodeNext module semantics are
  // restated here so this package typechecks identically regardless of what
  // resolution the base picks for the app workspaces (packages + server are
  // node16-style, apps/mobile is bundler-style).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    // TypeScript 6 no longer auto-includes node_modules/@types — this package
    // needs no ambient types at all (no node built-ins on the wire), so the
    // list is deliberately empty.
    "types": []
  },
  "include": ["src"]
}
