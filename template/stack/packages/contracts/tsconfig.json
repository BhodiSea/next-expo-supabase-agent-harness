{
  // @app/contracts — pure-Zod wire contracts, consumed by EVERY surface: the
  // Next app (server components, server actions, route handlers), the tRPC
  // router, and the Expo bundle. Plain ESM, no bundler, zod-only: nothing in
  // this package may import a database client, `next/*` or `react-native*` —
  // the boundaries gate enforces it.
  // Extends the repo-wide max-strict base; NodeNext module semantics are
  // restated here so this package typechecks identically regardless of what
  // resolution the base picks for the app workspaces (packages are node16-style,
  // apps/mobile is bundler-style).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    // TypeScript 6 no longer auto-includes node_modules/@types — this package
    // needs no ambient types at all (no node built-ins on the wire), so the
    // list is deliberately empty. It is also what keeps a `process.env` or a
    // `Buffer` from compiling here by accident: neither exists in Hermes.
    "types": []
  },
  "include": ["src"]
}
