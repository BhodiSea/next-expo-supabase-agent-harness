{
  // Next 16 App Router surface. Extends the repo-wide max-strict base and overrides ONLY
  // the keys a bundler-hosted React app genuinely needs — the same sanctioned split
  // apps/mobile takes for Metro (see ../../tsconfig.base.json).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // NOT composite, and noEmit — a build LEAF (see apps/mobile/tsconfig.json for the full
    // reasoning). Nothing imports this app, so it never emits a declaration; it is
    // typechecked as a `tsc -b` build root whose `references` build the composite packages
    // it depends on. The Next compiler owns JS output. SOURCE: design/W1-STACK-SPEC.md §3
    "noEmit": true,
    // Off explicitly (the repo base turns them on for the package graph): `declaration: true`
    // runs the declaration-nameability check even under noEmit, reding TS2883 on types a leaf
    // never emits. See apps/mobile/tsconfig.json.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    // Bundler resolution, not NodeNext: the app is bundled, so relative imports carry no
    // `.js` extension and the `exports` maps of the raw-TS @app/* packages resolve the way
    // Next resolves them. This pair is the ONLY resolution split the base tolerates.
    "module": "esnext",
    "moduleResolution": "bundler",
    // The skew guard's server version reads this app's OWN package.json version (see
    // app/api/trpc/[trpc]/route.ts) — the same single-source pattern apps/mobile uses in
    // app.config.ts. That import needs resolveJsonModule; the base leaves it off (only the
    // Metro app turned it on), so it is restated here, scoped to this app.
    "resolveJsonModule": true,
    // "preserve" is mandatory — Next transforms JSX itself (with the React Compiler and
    // its own fast-refresh instrumentation). Letting tsc transform it first would strip
    // exactly the syntax Next needs to see.
    "jsx": "preserve",
    // The base narrows lib to ES2023 for Node workspaces; the DOM lib is what makes this
    // app a browser app. DOM.Iterable is separate and is what types `for...of` over
    // FormData / URLSearchParams / NodeList — omitting it is the usual cause of a
    // mysterious "must have a '[Symbol.iterator]()'" on a perfectly ordinary loop.
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    // node: Server Components, Route Handlers, the proxy and the test suites all run on
    // Node (process.env, node:fs in the matcher test).
    "types": ["node"],
    // The Next TS plugin: it type-checks the App Router's own conventions (a Client
    // Component receiving a non-serializable prop, an invalid `export const` in a page).
    "plugins": [{ "name": "next" }],
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  // next-env.d.ts is what declares the `*.css` module (app/layout.tsx imports globals.css)
  // and Next's static-asset types. It is generated by `next dev`/`next build` and committed
  // deliberately: without it a cold `tsc -b` on a fresh clone — the exact thing CI does
  // before ever running Next — cannot resolve the stylesheet import.
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "proxy.ts",
    "vitest.config.ts",
    "app",
    "lib",
    "__tests__"
  ],
  // The layering law (apps -> api -> verticals -> platform) expressed as build order. The
  // kernel packages come last in the chain and first in the build; `tsc -b` walks it.
  "references": [
    { "path": "../../packages/api" },
    { "path": "../../packages/contracts" },
    { "path": "../../packages/verticals/notes" },
    { "path": "../../packages/platform/errors" },
    { "path": "../../packages/platform/supabase" },
    { "path": "../../packages/design-system" },
    { "path": "../../packages/design-tokens" }
  ]
}
