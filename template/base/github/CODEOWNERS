# CODEOWNERS — mandatory human review for security/regulated surfaces.
# Pair with branch protection (require review + the quality-gate checks) so the gate
# cannot be skipped. SOURCE: docs/harness/README.md (mandatory human review).
# NOTE: the installer substitutes the tokens — {{GITHUB_OWNER}} is your GitHub user/org
# (the catch-all default owner) and {{SECURITY_OWNERS}} is the @handle(s) / @org/team(s)
# that must sign off on security surfaces (may be several, space-separated). If you are
# editing this file by hand, replace both tokens with real handles.

# Default owner for everything.
*                                             @{{GITHUB_OWNER}}

# Auth / data / tenancy boundaries — REQUIRE sign-off. Authorization is RLS at the
# database, so the migrations/policies, the request-scoped clients, and the DAL that
# rides them are the surfaces that need eyes.
/supabase/**                                  {{SECURITY_OWNERS}}
/packages/api/**                              {{SECURITY_OWNERS}}
/packages/verticals/**                        {{SECURITY_OWNERS}}
/packages/contracts/**                        {{SECURITY_OWNERS}}
/packages/platform/supabase/**                {{SECURITY_OWNERS}}
/apps/web/lib/supabase/**                     {{SECURITY_OWNERS}}
/tests/rls/**                                 {{SECURITY_OWNERS}}

# Mobile platform security surface — store identity, transport policy, credential seam.
/apps/mobile/app.config.ts                    {{SECURITY_OWNERS}}
/apps/mobile/eas.json                         {{SECURITY_OWNERS}}
/apps/mobile/src/host/**                      {{SECURITY_OWNERS}}
/apps/mobile/src/auth/**                      {{SECURITY_OWNERS}}

