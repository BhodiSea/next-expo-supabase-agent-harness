{
  "name": "{{PROJECT_SLUG}}",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": "github:{{GITHUB_OWNER}}/{{PROJECT_SLUG}}",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node tools/validate.mjs",
    "typecheck": "tsc -b . apps/web apps/mobile",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "biome check --write .",
    "knip": "knip --strict",
    "arch": "depcruise apps packages --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:mobile": "pnpm --filter mobile exec jest",
    "test:rls": "node tests/rls/run-rls.mjs",
    "mutation": "stryker run stryker.config.mjs && node tools/check-mutation-ratchet.mjs",
    "mutation:baseline": "node tools/check-mutation-ratchet.mjs --write",
    "perf:baseline": "node tools/perf-baseline.mjs",
    "spell": "cspell --no-progress --gitignore .",
    "db:up": "supabase start",
    "db:down": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/platform/supabase/src/database.types.ts",
    "db:scale": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/seeds/scale.sql",
    "db:perf": "node tools/check-db-perf.mjs",
    "dev:web": "pnpm --filter web run dev",
    "dev:mobile": "pnpm --filter mobile run dev",
    "gen:contracts": "pnpm exec tsx tools/gen-action-inventory.mjs && pnpm exec tsx tools/gen-event-catalog.mjs && pnpm exec tsx tools/gen-query-shapes.mjs",
    "gen": "pnpm db:types && pnpm --filter @app/design-tokens run gen && pnpm gen:contracts && pnpm gen:routes",
    "gen:routes": "node tools/gen-web-routes.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@app/api": "workspace:*",
    "@app/events": "workspace:*",
    "@app/notes": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cspell": "catalog:",
    "dependency-cruiser": "catalog:",
    "supabase": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-native": "catalog:",
    "eslint-plugin-react-native-a11y": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "postgres": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
