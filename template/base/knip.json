{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/*.mjs",
        "tools/mcp/**/*.mjs",
        "tests/rls/*.mjs",
        "tests/rls/**/*.test.ts",
        "tests/migrations/*.mjs",
        "eslint.config.mjs",
        "stryker.config.mjs"
      ],
      "project": ["tools/**/*.mjs", "tests/**/*.{mjs,ts}", "*.{mjs,ts}"],
      "ignoreBinaries": ["supabase"]
    },
    "apps/web": {
      "entry": [
        "app/**/*.{ts,tsx}!",
        "proxy.ts!",
        "next.config.ts",
        "postcss.config.mjs",
        "app/**/*.test.{ts,tsx}",
        "lib/**/*.test.{ts,tsx}"
      ],
      "project": ["app/**/*.{ts,tsx}!", "lib/**/*.{ts,tsx}!", "*.{ts,mjs}"]
    },
    "apps/mobile": {
      "entry": [
        "app/**/*.{ts,tsx}!",
        "app.config.ts",
        "babel.config.js",
        "metro.config.js",
        "jest.config.js",
        "src/features/matrix/perfSubject.tsx!",
        "src/crash/redact.ts!",
        "src/testing/mock-server.ts",
        "src/host/env.ts",
        "src/**/*.test.{ts,tsx}",
        "__tests__/**/*.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}!",
        "app/**/*.{ts,tsx}!",
        "__tests__/**/*.{ts,tsx}",
        "*.{ts,js}"
      ],
      "ignoreDependencies": ["expo-crypto", "expo-updates", "react-native-css-interop"]
    },
    "packages/api": {
      "entry": ["src/index.ts!", "src/**/*.test.ts"],
      "project": ["src/**/*.ts!"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts!", "src/**/*.test.ts"],
      "project": ["src/**/*.ts!"]
    },
    "packages/design-tokens": {
      "entry": ["src/index.ts!", "src/client.ts!", "scripts/gen.mjs", "src/**/*.test.ts"],
      "project": ["src/**/*.ts!", "scripts/*.mjs"],
      "ignore": ["src/generated/**"]
    },
    "packages/design-system": {
      "entry": ["src/index.ts!", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}!"]
    },
    "packages/design-system-native": {
      "entry": ["src/index.ts!", "src/preset.ts!", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}!"]
    },
    "packages/platform/errors": {
      "entry": ["src/index.ts!", "src/**/*.test.ts"],
      "project": ["src/**/*.ts!"]
    },
    "packages/platform/events": {
      "entry": ["src/index.ts!", "src/**/*.test.ts"],
      "project": ["src/**/*.ts!"]
    },
    "packages/platform/env": {
      "entry": ["src/index.ts!", "src/client.ts!", "src/**/*.test.ts"],
      "project": ["src/**/*.ts!"]
    },
    "packages/platform/observability": {
      "entry": ["src/index.ts!", "src/**/*.test.ts"],
      "project": ["src/**/*.ts!"]
    },
    "packages/platform/supabase": {
      "entry": ["src/index.ts!", "src/client.ts!", "src/**/*.test.ts"],
      "project": ["src/**/*.ts!"]
    },
    "packages/verticals/notes": {
      "entry": ["src/index.ts!", "src/client.ts!", "src/**/*.test.ts"],
      "project": ["src/**/*.ts!"]
    }
  }
}
