{
  // Biome = formatter + import organizer ONLY. The linter is OFF: ESLint
  // (typescript-eslint strictTypeChecked et al.) is the single lint owner, so
  // the two tools can never disagree about the same rule.
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true // dist/, .expo/, android/, ios/, coverage/ etc. come from .gitignore
  },
  "files": {
    "includes": [
      "**",
      // Generated-but-committed artifacts: byte-stability matters more than style.
      // Generated by `supabase gen types` (`pnpm db:types`) and byte-diffed by the
      // types-drift gate — a formatter pass would read as schema drift.
      "!**/packages/platform/supabase/src/database.types.ts",
      // The committed contract inventories — emitted by tools/gen-{action-inventory,event-catalog}.mjs
      // and byte-diffed by the `contracts` gate; a formatter pass would read as drift.
      "!**/tools/generated/**",
      // Installer-written manifest (JSON.stringify shape, hash-verified by doctor).
      "!**/.harness/manifest.json",
      "!**/packages/schema/drizzle",
      "!**/packages/schema/drizzle/**",
      // Harness-owned hook/tool internals are not project code.
      "!**/.claude",
      "!**/.claude/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  // Biome does NOT own CSS in this stack. apps/web is Tailwind v4 (CSS-first `@theme`,
  // `@import "tailwindcss"`) and packages/design-tokens emits a generated theme .css. The
  // parser must be told about Tailwind's at-rules or it aborts the whole `biome ci` gate on a
  // parse error; the formatter stays OFF so Biome never reflows a hand-authored `@theme` block
  // or the byte-stable generated .css (which the styleguide gate regen-diffs). Tailwind's own
  // pipeline and the token generator own that CSS. SOURCE: docs/harness/README.md (one owner
  // per concern)
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": false
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": false
  },
  "overrides": [
    {
      // tsconfig files are JSONC by TypeScript convention.
      "includes": ["**/tsconfig.json", "**/tsconfig.*.json", "tsconfig.base.json"],
      "json": {
        "parser": {
          "allowComments": true,
          "allowTrailingCommas": true
        }
      }
    }
  ]
}
