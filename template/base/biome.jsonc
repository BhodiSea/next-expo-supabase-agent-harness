{
  // Biome = formatter + import organizer ONLY. The linter is OFF: ESLint
  // (typescript-eslint strictTypeChecked et al.) is the single lint owner, so
  // the two tools can never disagree about the same rule.
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true // dist/, .expo/, android/, ios/, coverage/ etc. come from .gitignore
  },
  "files": {
    "includes": [
      "**",
      // Generated-but-committed artifacts: byte-stability matters more than style.
      // tokens.gen.ts is emitted by tools/gen-theme.mjs and the styleguide gate
      // regen-diffs its raw bytes — a formatter pass would read as drift.
      "!**/apps/mobile/src/theme/tokens.gen.ts",
      "!**/apps/server/openapi.json",
      // Installer-written manifest (JSON.stringify shape, hash-verified by doctor).
      "!**/.harness/manifest.json",
      "!**/packages/schema/drizzle",
      "!**/packages/schema/drizzle/**",
      // Harness-owned hook/tool internals are not project code.
      "!**/.claude",
      "!**/.claude/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": false
  },
  "overrides": [
    {
      // tsconfig files are JSONC by TypeScript convention.
      "includes": ["**/tsconfig.json", "**/tsconfig.*.json", "tsconfig.base.json"],
      "json": {
        "parser": {
          "allowComments": true,
          "allowTrailingCommas": true
        }
      }
    }
  ]
}
