# Normalize line endings; Windows-only script types keep CRLF.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.icns binary

# Generated-but-committed artifacts: collapse in review, regenerate on drift.
packages/design-tokens/src/generated/** linguist-generated=true
packages/platform/supabase/src/types.ts linguist-generated=true
tools/generated/** linguist-generated=true
pnpm-lock.yaml linguist-generated=true
