# {{PROJECT_NAME}} — environment contract. Copy to .env (gitignored) and fill in.
# Values ship EMPTY by design; the comments describe the local-dev defaults that
# docker-compose.yml + db/init/01-roles.sql provision. No real credential ever
# belongs in this file.

# ---- database ----------------------------------------------------------------
# Connection for the API server. Uses the app_api role: LOGIN, NOSUPERUSER,
# NOBYPASSRLS — every query is subject to FORCE row-level security.
# Local-dev default: role app_api (password: postgres) at 127.0.0.1:5432,
# database {{DB_NAME}}.
DATABASE_URL=

# Connection for drizzle migrations only. Uses the app_migrator role, which owns
# the schema. Never hand this DSN to the API server.
# Local-dev default: role app_migrator (password: postgres), same host/database.
MIGRATOR_DATABASE_URL=

# ---- api server ----------------------------------------------------------------
# Hono server port. Default: 8787.
PORT=
# pino level: trace|debug|info|warn|error. Default: info.
LOG_LEVEL=

# ---- auth ----------------------------------------------------------------------
# stub  = verify against a local JWKS written by `pnpm --filter server mint-dev-token`
#         or by the dev-only POST /auth/dev-token route (both write
#         .dev-auth/jwks.json; dev only — the server refuses to boot with
#         AUTH_MODE=stub when NODE_ENV=production).
# entra = verify against the tenant's remote JWKS discovered from the IDs below.
AUTH_MODE=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
API_AUDIENCE=

# ---- mobile (dev only) ---------------------------------------------------------
# Origin the app calls during `pnpm dev:mobile`. EXPO_PUBLIC_-prefixed vars are
# inlined into the client bundle — NEVER put a secret behind an EXPO_PUBLIC_ name.
# Default: {{API_ORIGIN}} (the committed app.config.ts extra.apiOrigin).
EXPO_PUBLIC_API_ORIGIN=

# Entra sign-in for the APP (mirrors the server's ENTRA_* pair above). Both are
# PUBLIC identifiers — they appear verbatim in every authorize redirect a
# browser can observe — which is why EXPO_PUBLIC_ inlining is safe here and only
# here; the flow's secret half is the per-attempt PKCE verifier, never stored,
# never configured. Leave both empty to use the dev stub sign-in; set both to
# enable the Entra flow (src/auth/providers/entra.ts).
EXPO_PUBLIC_ENTRA_TENANT_ID=
EXPO_PUBLIC_ENTRA_CLIENT_ID=
