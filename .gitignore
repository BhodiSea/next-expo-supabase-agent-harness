node_modules/
*.log
.DS_Store
# Coverage artifacts (nothing generates these at the root today; belt-and-braces)
coverage/
# Local gate stamps
.harness/*.ok
# The factory Stop gate's turn ledger (0.6.0) — local run state, same as a stamp. It is what
# makes a maintainer turn that ended at CLAUDE_CODE_STOP_HOOK_BLOCK_CAP distinguishable from
# one that ended green, which through 0.5.0 it was not.
.harness/turn-outcomes.jsonl
# The advisory concurrent-session lock (0.9.0): {session_id, pid, at}, written by
# the Stop gate and read by `installer update`. Pure runtime state about THIS
# machine's session — committing it would carry one developer's pid into every
# other checkout, which is how it reached the index in the first place.
.harness/turn.lock
# Scratch fixtures created by local selftest runs
.fixtures/
# The upgrade lane's workdir (scripts/ci/upgrade-lane.sh) — a whole rendered scaffold
# WITH node_modules, kept after the run because it is what you read when the lane reds.
# Unignored it was worse than untidy: `git add -A` would commit an install, and the
# complexity ratchet walked the scaffold's own tools/ and red the factory for code the
# factory ships. Ignored, not deleted — the evidence is the point.
.selftest/
# Build artifacts a local `tsc -b` / `expo export` can drop INSIDE the template tree.
# template/base/gitignore ships these rules to every scaffold — but that file only
# protects CONSUMERS; this protects the shipped template itself from a `git add -A`.
template/**/dist/
template/**/dist-types/
template/**/.expo/
*.tsbuildinfo
# CNG purity: generated native projects must never be committed, anywhere.
template/**/android/
template/**/ios/
